# Server Environment Variables

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/shri-ananda-nilayam

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d

# Server
PORT=5000
NODE_ENV=development

# CORS - comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Cookie
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Admin Bootstrap (for first-time setup only)
BOOTSTRAP_ADMIN_EMAIL=admin@srianandanilayam.example
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe@123

# Email (SMTP - required for password reset in production)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@srianandanilayam.example
SMTP_PASS=your-smtp-password
EMAIL_FROM=Sri Ananda Nilayam <noreply@srianandanilayam.example>

# File Upload
MAX_FILE_SIZE_MB=10
UPLOAD_PATH=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=5
